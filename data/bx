#
#  Command-line completion for bx.
#
_bx()
{
    local current="${COMP_WORDS[COMP_CWORD]}"

    # Generated from XML data source.
    local commands="
        address-decode
        address-embed
        address-encode
        address-to-key
        address-to-script
        base16-decode
        base16-encode
        base32-decode
        base32-encode
        base58-decode
        base58-encode
        base64-decode
        base64-encode
        bech32-decode
        bech32-encode
        bitcoin160
        bitcoin256
        btc-to-satoshi
        cert-new
        cert-public
        checked-decode
        checked-encode
        dice-entropy
        dice-rolls
        ec-add
        ec-add-secrets
        ec-decompress
        ec-multiply
        ec-multiply-secrets
        ec-new
        ec-to-address
        ec-to-ek
        ec-to-public
        ec-to-wif
        ec-to-witness
        ek-address
        ek-new
        ek-public
        ek-public-to-address
        ek-public-to-ec
        ek-to-address
        ek-to-ec
        electrum-decode
        electrum-new
        electrum-to-prefix
        electrum-to-seed
        electrum-v1-decode
        electrum-v1-encode
        electrum-v1-to-seed
        fetch-balance
        fetch-block
        fetch-block-hashes
        fetch-block-height
        fetch-filter
        fetch-filter-checkpoint
        fetch-filter-headers
        fetch-header
        fetch-height
        fetch-history
        fetch-public-key
        fetch-tx
        fetch-tx-index
        fetch-utxo
        hd-new
        hd-private
        hd-public
        hd-to-ec
        hd-to-public
        help
        input-set
        input-sign
        input-validate
        match-neutrino-address
        match-neutrino-script
        message-sign
        message-validate
        mnemonic-decode
        mnemonic-encode
        mnemonic-to-seed
        qrcode
        ripemd160
        satoshi-to-btc
        script-decode
        script-encode
        script-to-address
        script-to-key
        script-to-witness
        send-tx
        settings
        sha160
        sha256
        sha512
        slip39-combine
        slip39-decode
        slip39-split
        stealth-public
        stealth-secret
        stealth-shared
        subscribe-block
        subscribe-tx
        token-new
        tx-decode
        tx-encode
        uri-decode
        uri-encode
        validate-tx
        version
        watch-key
        watch-tx
        wif-to-ec
        wif-to-public
        witness-to-key
        witness-to-script
    "

    if [[ $COMP_CWORD -eq 1 ]]; then
        COMPREPLY=( `compgen -W "$commands" -- "$current"` )
        return
    fi

    local common="--config -c --help -h"
    local options=""

    # Generated from XML data source.
    case "${COMP_WORDS[1]}" in
        address-embed)
            options="--version -v"
            ;;
        address-encode)
            options="--version -v"
            ;;
        bech32-encode)
            options="--version -v"
            ;;
        checked-encode)
            options="--version -v"
            ;;
        dice-entropy)
            options="--sides -s"
            ;;
        dice-rolls)
            options="--sides -s --bits -b"
            ;;
        ec-to-address)
            options="--version -v"
            ;;
        ec-to-ek)
            options="--uncompressed -u --version -v"
            ;;
        ec-to-public)
            options="--uncompressed -u"
            ;;
        ec-to-wif)
            options="--uncompressed -u --version -v"
            ;;
        ek-address)
            options="--uncompressed -u --version -v"
            ;;
        ek-new)
            options="--uncompressed -u --version -v"
            ;;
        ek-public)
            options="--uncompressed -u --version -v"
            ;;
        electrum-decode)
            options="--language -l"
            ;;
        electrum-new)
            options="--language -l --prefix -p"
            ;;
        electrum-to-seed)
            options="--language -l --passphrase -p"
            ;;
        electrum-v1-decode)
            options="--language -l"
            ;;
        electrum-v1-encode)
            options="--language -l"
            ;;
        electrum-v1-to-seed)
            options="--language -l"
            ;;
        fetch-block)
            options="--hash -s --height -t"
            ;;
        fetch-block-hashes)
            options="--hash -s --height -t"
            ;;
        fetch-filter)
            options="--hash -s --height -t --type -f"
            ;;
        fetch-filter-headers)
            options="--stop_hash -s --stop_height -t"
            ;;
        fetch-header)
            options="--hash -s --height -t"
            ;;
        fetch-tx)
            options="--witness -w"
            ;;
        fetch-utxo)
            options="--algorithm -a"
            ;;
        hd-new)
            options="--version -v"
            ;;
        hd-private)
            options="--hard -d --index -i --secret_version -s --public_version -p"
            ;;
        hd-public)
            options="--hard -d --index -i --secret_version -s --public_version -p"
            ;;
        hd-to-ec)
            options="--secret_version -s --public_version -p"
            ;;
        hd-to-public)
            options="--secret_version -s --version -v"
            ;;
        input-set)
            options="--index -i"
            ;;
        input-sign)
            options="--anyone -a --index -i --sign_type -s"
            ;;
        input-validate)
            options="--index -i"
            ;;
        mnemonic-decode)
            options="--language -l"
            ;;
        mnemonic-encode)
            options="--language -l"
            ;;
        mnemonic-to-seed)
            options="--language -l --passphrase -p"
            ;;
        qrcode)
            options="--margin -m --pixels -p --version -v"
            ;;
        script-decode)
            options="--flags -f"
            ;;
        script-to-address)
            options="--version -v"
            ;;
        script-to-key)
            options="--version -v"
            ;;
        slip39-combine)
            options="--passphrase -p"
            ;;
        slip39-split)
            options="--exponent -e --group -g --identifier -i --passphrase -p --secret -s --threshold -t --unextendable -u"
            ;;
        subscribe-block)
            options="--duration -d"
            ;;
        subscribe-tx)
            options="--duration -d"
            ;;
        token-new)
            options="--lot -l --sequence -s"
            ;;
        tx-encode)
            options="--lock_time -l --version -v --input -i --output -o"
            ;;
        uri-encode)
            options="--amount -a --label -l --message -m --request -r"
            ;;
        watch-key)
            options="--duration -d"
            ;;
        watch-tx)
            options="--duration -d"
            ;;
    esac

    # Only options are completed; other words fall back to the default.
    if [[ "$current" == -* ]]; then
        COMPREPLY=( `compgen -W "$common $options" -- "$current"` )
    fi
}
complete -o default -F _bx bx
