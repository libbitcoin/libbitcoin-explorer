.template 0
###############################################################################
# Copyright (c) 2011-2023 libbitcoin developers (see COPYING).
#
# GSL generate libbitcoin-explorer source files.
# This file contains no localizable resources.
#
# This is a code generator built using the iMatix GSL code generation
# language. See https://github.com/imatix/gsl for details.
###############################################################################
.endtemplate
.template 1
.echo "Generating data/bx..."
.output "../data/bx"
#
#  Command-line completion for bx.
#
_bx()
{
    local current="${COMP_WORDS[COMP_CWORD]}"

    # Generated from XML data source.
    local commands="
.for command by symbol as _command where !is_xml_true(_command.obsolete)
        $(_command.symbol)
.endfor _command
    "

    if [[ $COMP_CWORD -eq 1 ]]; then
        COMPREPLY=( `compgen -W "$commands" -- "$current"` )
        return
    fi

    local common="--config -c --help -h"
    local options=""

    # Generated from XML data source.
    case "${COMP_WORDS[1]}" in
.for command by symbol as _command where !is_xml_true(_command.obsolete)
.   define option_list = ""
.   for _command.option as _option
.       short_name = _option.shortcut ? first_char(_option.name)
.       if (option_list <> "")
.           option_list += " "
.       endif
.       option_list += "--$(_option.name:lower,c)"
.       if (short_name <> "")
.           option_list += " -$(short_name)"
.       endif
.   endfor _option
.   if (option_list <> "")
        $(_command.symbol))
            options="$(option_list)"
            ;;
.   endif
.endfor _command
    esac

    # Only options are completed; other words fall back to the default.
    if [[ "$current" == -* ]]; then
        COMPREPLY=( `compgen -W "$common $options" -- "$current"` )
    fi
}
complete -o default -F _bx bx
.endtemplate
