function global.is_unquoted_type(type)
    return (my.type = "bool") | \
        (my.type = "size_t") | \
        (my.type = "uint8_t") | \
        (my.type = "uint16_t") | \
        (my.type = "uint32_t") | \
        (my.type = "uint64_t") | \
        (my.type = "explorer::config::byte")
endfunction

